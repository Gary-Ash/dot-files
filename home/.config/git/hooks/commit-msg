#!/usr/bin/env perl
#*****************************************************************************************
# commit-msg
#
# Git commit-msg hook enforcing the project commit message conventions, reopening
# the editor so a malformed message can be repaired in place
#
# Author   :  Gary Ash <gary.ash@icloud.com>
# Created  :   1-Sep-2026  4:42pm
# Modified :   5-Sep-2026  4:53pm
#
# Copyright © 2026 By Gary Ash All rights reserved.
#*****************************************************************************************

use strict;
use warnings;

my $MAX_LINE     = 72;
my $MAX_ATTEMPTS = 5;
my $MARKER       = '# commit-msg:';

my @TAGS = ('BUG FIX', 'FEATURE', 'REFACTOR', 'TEST CODE', 'TIDY');

my $msgfile = shift(@ARGV);
die("usage: commit-msg <message file>\n") unless defined($msgfile) && length($msgfile);

exit(0) if $ENV{SKIP_COMMIT_MSG_HOOK};

# Git sets the editor to ':' for commits that never open one, --message, --file,
# --no-edit and --reuse-message among them, so there is nothing to return to
my $editor      = git_editor();
my $interactive = $editor ne ':';

my @message;
for my $attempt (1 .. $MAX_ATTEMPTS) {
    @message = load_message($msgfile);

    my @errors = validate(strip_comments(@message));
    exit(0) unless @errors;

    unless ($interactive) {
        report_to_terminal($msgfile, @errors);
        exit(1);
    }

    annotate($msgfile, [@message], [@errors]);

    my $status = launch_editor($editor, $msgfile);
    if ($status != 0) {
        load_message($msgfile);
        print(STDERR "commit-msg: the editor exited with an error, the commit was abandoned\n");
        exit(1);
    }
}

report_to_terminal($msgfile, validate(strip_comments(load_message($msgfile))));
exit(1);

#*****************************************************************************************
# ask Git which editor is in play, ':' means the commit was made without one, as
# happens with --message, --file, --no-edit and --reuse-message
#*****************************************************************************************
sub git_editor {
    my $answer = `git var GIT_EDITOR 2>/dev/null`;
    return ':' if $? != 0 || !defined($answer);

    chomp($answer);
    return length($answer) ? $answer : ':';
}

sub read_message {
    my ($path) = @_;

    open(my $fh, '<', $path) or die("commit-msg: cannot read $path: $!\n");
    my @lines = <$fh>;
    close($fh);

    chomp(@lines);
    return @lines;
}

#*****************************************************************************************
# read the message back, dropping any complaints left behind by an earlier pass so
# they never reach the recorded commit
#*****************************************************************************************
sub load_message {
    my ($path) = @_;

    my @lines = read_message($path);
    my @kept  = grep { !is_marker($_) } @lines;

    pop(@kept) while @kept && $kept[-1] eq '';
    write_message($path, @kept) if @kept != @lines;

    return @kept;
}

sub write_message {
    my ($path, @lines) = @_;

    open(my $fh, '>', $path) or die("commit-msg: cannot write $path: $!\n");
    print {$fh} map { "$_\n" } @lines;
    close($fh);
    return;
}

sub is_marker {
    my ($line) = @_;
    return index($line, $MARKER) == 0 ? 1 : 0;
}

#*****************************************************************************************
# reduce the file to the message Git will actually record, dropping comments, the
# verbose diff below the scissors line and any trailing blank lines
#*****************************************************************************************
sub strip_comments {
    my @lines = @_;
    my @message;

    for my $line (@lines) {
        last if $line =~ /^#\s*-+\s*>8\s*-+/;
        next if $line =~ /^#/;

        $line =~ s/\s+$//;
        push(@message, $line);
    }

    pop(@message)   while @message && $message[-1] eq '';
    shift(@message) while @message && $message[0] eq '';

    return @message;
}

#*****************************************************************************************
# check the message, returning a list of complaints, an empty list means it is good
#*****************************************************************************************
sub validate {
    my @lines = @_;

    # an empty message is Git's business, it aborts the commit on its own
    return () unless @lines;

    my $subject = $lines[0];

    # messages Git composes for itself are none of this hook's business
    return () if $subject =~ /^(?:fixup|squash|amend)!/;
    return () if $subject =~ /^Merge\s/;
    return () if $subject =~ /^Revert\s"/;
    return () if in_progress_operation();

    return () if $subject eq 'Initial commit' && @lines == 1;

    my @errors = check_subject($subject);
    push(@errors, check_body(@lines));
    return @errors;
}

#*****************************************************************************************
# a merge, revert, cherry pick or rebase replays messages this hook did not write
#*****************************************************************************************
sub in_progress_operation {
    my $git_dir = `git rev-parse --git-dir 2>/dev/null`;
    return 0 if $? != 0;

    chomp($git_dir);
    return 0 unless length($git_dir);

    for my $marker (qw(MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply)) {
        return 1 if -e "$git_dir/$marker";
    }
    return 0;
}

sub check_subject {
    my ($subject) = @_;
    my @errors;

    if ($subject !~ /^\[([A-Z][A-Z ]*)\](.*)$/) {
        return ('the summary line must begin with a tag, one of ' . join(', ', map { "[$_]" } @TAGS),);
    }

    my ($tag, $rest) = ($1, $2);

    unless (grep { $_ eq $tag } @TAGS) {
        push(@errors, "[$tag] is not a known tag, use one of " . join(', ', map { "[$_]" } @TAGS));
    }

    if ($rest !~ /^ \S/) {
        push(@errors, 'exactly one space must separate the tag from the summary');
    }

    my $summary = $rest;
    $summary =~ s/^\s+//;

    unless (length($summary)) {
        push(@errors, 'the summary line has a tag but no summary');
        return @errors;
    }

    push(@errors, 'the summary line must not end with a period') if $summary =~ /\.$/;

    my $length = length($subject);
    push(@errors, "the summary line is $length characters, keep it inside $MAX_LINE")
      if $length > $MAX_LINE;

    push(@errors, check_capitalization($summary));
    return @errors;
}

#*****************************************************************************************
# capitalization, the summary has to open with a capital and the rest of it is the
# author's business - a summary is often about ps, pgrep or awk, and a tool wearing
# its own lower case name is not a mistake to be corrected
#*****************************************************************************************
sub check_capitalization {
    my ($summary) = @_;

    my ($word) = grep { length } split(/\s+/, $summary);
    return () unless defined($word);

    # code spans, options, paths, versions and names that carry their own
    # capitalization are left alone
    return () if $word =~ /[`'"]/;
    return () if $word =~ /\d/;
    return () if $word =~ /[A-Z]/;

    $word =~ s/^[^\p{L}]+//;
    $word =~ s/[^\p{L}]+$//;
    return () unless length($word);

    # only the leading element of a hyphenated or dotted word is judged
    $word = (split(/[-.\/_]/, $word))[0];
    return () unless defined($word) && length($word);
    return () if $word =~ /^\p{Lu}/;

    return ("the summary line must open with a capital, capitalize $word");
}

sub check_body {
    my @lines = @_;
    return () if @lines == 1;

    my @errors;
    if ($lines[1] ne '') {
        push(@errors, 'a blank line must separate the summary line from the body');
    }

    my @body = @lines[2 .. $#lines];
    push(@errors, 'the body is empty, drop it or write a description')
      unless grep { /\S/ } @body;

    my $listed = 0;
    my $long   = 0;

    for my $line (@body) {
        $listed = 1 if !$listed && $line =~ /^\s*(?:[-*+•·]|\(?\d+[.)])\s+\S/;

        # a line holding a single unbreakable token, a URL say, cannot be wrapped
        next if length($line) <= $MAX_LINE || $line !~ /\s/;
        $long = 1;
    }

    push(@errors, 'the body must be prose, not bullet points or a numbered list') if $listed;
    push(@errors, "the body must be wrapped at $MAX_LINE characters")             if $long;

    return @errors;
}

#*****************************************************************************************
# write the complaints into the message file as comments so they are in front of
# the author when the editor reopens, Git strips them before recording the commit
#*****************************************************************************************
sub annotate {
    my ($path, $raw, $errors) = @_;

    my @lines = grep { !is_marker($_) } @{$raw};

    my @notes = ("$MARKER the commit message was rejected");
    push(@notes, "$MARKER   - $_") for @{$errors};
    push(@notes, $MARKER,   map { "$MARKER $_" } format_rules());
    push(@notes, "$MARKER", "$MARKER empty the message to abandon the commit");

    # slot the complaints in ahead of Git's own comments and the verbose diff so
    # they are the first thing the author sees
    my $at = 0;
    $at++ while $at <= $#lines && $lines[$at] !~ /^#/;

    splice(@lines, $at, 0, '', @notes, '');
    write_message($path, @lines);
    return;
}

sub report_to_terminal {
    my ($path, @errors) = @_;

    print(STDERR "\ncommit-msg: the commit message was rejected\n\n");
    print(STDERR "  - $_\n") for @errors;
    print(STDERR "\n");
    print(STDERR "  $_\n") for format_rules();
    print(STDERR "\nthe message was left in $path, edit it with\n");
    print(STDERR "  git commit --edit --file $path\n\n");
    return;
}

sub format_rules {
    return (
        'the expected format is',
        '',
        '    [TAG] Short summary opening with a capital',
        '',
        '    A description written in prose, wrapped at 72 characters. The body',
        '    is optional, a tag and a summary line on their own are a complete',
        '    message.',
        '',
        'the tags are ' . join(', ', map { "[$_]" } @TAGS),
        'the summary line must open with a capital and must not end with a period',
        'the body must be prose, no bullet points and no numbered lists',
    );
}

#*****************************************************************************************
# hand the message back to the editor, Git may have handed this hook a stdin of
# /dev/null so the terminal is reattached for editors that insist on one
#*****************************************************************************************
sub launch_editor {
    my ($command, $path) = @_;

    my $script
      = 'if ( exec </dev/tty >/dev/tty ) 2>/dev/null; ' . 'then exec </dev/tty >/dev/tty 2>/dev/tty; fi; ' . $command . ' "$@"';

    my $status = system('sh', '-c', $script, 'sh', $path);
    return -1 if $status == -1;
    return $status >> 8;
}
